# --- Facturacion (CFDI 4.0) ---
# simulado = facturas de prueba sin validez fiscal (no necesita credenciales)
# finkok   = timbra con Finkok usando el CSD cargado en la cuenta de Finkok
CFDI_PAC=simulado
CFDI_EMISOR_RFC=EKU9003173C9
CFDI_EMISOR_NOMBRE=OSO TOSTADAS
CFDI_EMISOR_REGIMEN=601
CFDI_LUGAR_EXPEDICION=42501
CFDI_CLAVE_PROD_SERV=50192100
CFDI_CLAVE_UNIDAD=H87
CFDI_DIAS_PARA_FACTURAR=30
# Ambiente de pruebas de Finkok. En produccion: https://facturacion.finkok.com
FINKOK_URL=https://demo-facturacion.finkok.com
FINKOK_USUARIO=
FINKOK_PASSWORD=

